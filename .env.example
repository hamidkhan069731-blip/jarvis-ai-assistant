# ============================================================================
# J.A.R.V.I.S. Configuration
# Copy this file to `.env` and fill in values. NEVER commit your real .env.
# All keys are optional — JARVIS runs offline in "Local" mode without any key.
# ============================================================================

# ---------------------------------------------------------------------------
# AI PROVIDER
# provider: anthropic | openai | local
#   - anthropic : uses ANTHROPIC_API_KEY (cloud)
#   - openai    : any OpenAI-compatible endpoint (OpenAI, local LLM servers,
#                 Ollama with OpenAI compat, LM Studio, etc.)
#   - local     : built-in offline rule-based command router (no key needed)
# If a cloud provider is selected but the key is missing, JARVIS automatically
# falls back to the local provider and clearly labels responses as "Local".
# ---------------------------------------------------------------------------
JARVIS_AI_PROVIDER=local

# --- Anthropic ---
ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI-compatible (also works with Ollama / LM Studio / vLLM) ---
OPENAI_API_KEY=
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
# Bind to 127.0.0.1 only. Do NOT expose JARVIS to a network without auth.

# ---------------------------------------------------------------------------
# PATHS  (defaults live under <project>/data)
# ---------------------------------------------------------------------------
# JARVIS_DATA_DIR=

# ---------------------------------------------------------------------------
# VOICE
# ---------------------------------------------------------------------------
JARVIS_WAKE_WORD=hey jarvis
JARVIS_TTS_ENABLED=true
JARVIS_TTS_RATE=175
JARVIS_TTS_VOLUME=1.0
# Leave voice id blank to use the system default SAPI5 voice.
JARVIS_TTS_VOICE=

# ---------------------------------------------------------------------------
# SECURITY / PERMISSIONS
# permission_mode: strict | balanced | trusted
#   strict   : auto-run only SAFE+LOW; confirm everything else EVERY time
#              (remembered "allow" is ignored — you are always re-asked)
#   balanced : auto-run SAFE+LOW; confirm the rest once (rememberable)
#   trusted  : auto-run SAFE up to MEDIUM; confirm the rest once (rememberable)
# In every mode, CRITICAL / always-confirm actions are asked every time and can
# never be remembered-away, and a remembered "deny" is always honoured.
# ---------------------------------------------------------------------------
JARVIS_PERMISSION_MODE=balanced

# Root under which file tools may operate. Multiple paths separated by ';'.
# Defaults to the user's home directory. Paths outside are denied.
# JARVIS_FILE_ROOTS=

# Shell execution is DISABLED by default. Enable explicitly if you accept
# the risk. Even when enabled, a blocklist + confirmation still applies.
JARVIS_ENABLE_SHELL=false

# Comma-separated apps allowed to be launched without confirmation.
JARVIS_APP_ALLOWLIST=notepad,calc,explorer,chrome,msedge,code,cmd,powershell

# ---------------------------------------------------------------------------
# MEMORY / PRIVACY
# ---------------------------------------------------------------------------
JARVIS_MEMORY_ENABLED=true
JARVIS_PROACTIVE_ENABLED=true

# ---------------------------------------------------------------------------
# LOGGING
# level: DEBUG | INFO | WARNING | ERROR
# ---------------------------------------------------------------------------
JARVIS_LOG_LEVEL=INFO
